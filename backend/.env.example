# Copy to backend/.env and fill in real values. Never commit backend/.env.

APP_ENV=development
APP_NAME=PlotPlanner
API_PREFIX=/api/v1

# Supabase Postgres. Dashboard -> Connect -> Session pooler (port 5432).
# The copied URI starts with postgresql://; that form is accepted.
# Percent-encode special characters in the password.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co (no trailing slash).
# Access tokens are verified against <SUPABASE_URL>/auth/v1/.well-known/jwks.json,
# so no JWT secret is needed. Never put a service-role key in any frontend file.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Browser origin allowed by CORS (no trailing slash).
FRONTEND_URL=http://localhost:5173

# Groq (OpenAI-compatible). Required for onboarding, pathways, plans and chat.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# YouTube Data API v3. Required to attach verified videos to pathways.
YOUTUBE_API_KEY=

# Optional. Adds Adzuna listings (some include provider salary estimates).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

MAX_UPLOAD_SIZE_MB=10
AI_REQUESTS_PER_MINUTE=12
MCP_ENABLED=true
