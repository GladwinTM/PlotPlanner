# Copy to frontend/.env. Only public values belong here: everything with a VITE_
# prefix is embedded in the browser bundle. Never put API keys, database URLs or
# service-role keys in this file.

# Backend API, including the version prefix.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase project URL and its *publishable* key (sb_publishable_...).
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
